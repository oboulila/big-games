<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>POCKET ARCADE — 10 IN 1</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@500;700;900&display=swap');

  * { margin: 0; padding: 0; box-sizing: border-box; user-select: none; -webkit-user-select: none; }
  body {
    background: #090b10;
    color: #f8fafc;
    font-family: 'Inter', sans-serif;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  header {
    width: 100%;
    background: #121624;
    border-bottom: 3px solid #ffbe0b;
    padding: 14px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1040px;
  }
  .logo {
    font-family: 'Press Start 2P', monospace;
    font-size: 14px;
    color: #ffbe0b;
  }
  .logo span { color: #3a86ff; }
  .menu-btn {
    background: #1e253c;
    color: #fff;
    border: 2px solid #3a86ff;
    padding: 7px 12px;
    border-radius: 6px;
    font-family: 'Press Start 2P', monospace;
    font-size: 9px;
    cursor: pointer;
    display: none;
  }
  .menu-btn:hover { background: #3a86ff; }

  #hub-view {
    width: 100%;
    max-width: 1040px;
    padding: 24px 16px;
  }
  .hub-title {
    font-family: 'Press Start 2P', monospace;
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 18px;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
  }
  .card {
    background: #141928;
    border: 2px solid #26304d;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: 0.2s;
    display: flex;
    flex-direction: column;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: #ffbe0b;
    box-shadow: 0 8px 25px rgba(255, 190, 11, 0.2);
  }
  .banner {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 42px;
  }
  .card-info {
    padding: 14px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .card-info h3 {
    font-size: 16px;
    font-weight: 900;
    margin-bottom: 6px;
  }
  .card-info p {
    font-size: 12px;
    color: #94a3b8;
    margin-bottom: 12px;
    line-height: 1.4;
  }
  .play-tag {
    background: #ffbe0b;
    color: #090b10;
    font-family: 'Press Start 2P', monospace;
    font-size: 8px;
    text-align: center;
    padding: 9px;
    border-radius: 6px;
  }

  #game-view {
    display: none;
    width: 100%;
    max-width: 960px;
    padding: 12px;
    flex-direction: column;
    align-items: center;
  }
  #canvas-container {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
    border: 3px solid #2b3554;
    border-radius: 8px;
    overflow: hidden;
    position: relative;
    touch-action: none;
  }
  canvas {
    width: 100%;
    height: 100%;
    display: block;
    image-rendering: pixelated;
  }
  #controls-hint {
    margin-top: 10px;
    font-size: 12px;
    color: #94a3b8;
    text-align: center;
  }
</style>
</head>
<body>

<header>
  <div class="logo">POCKET<span>ARCADE</span> 10-IN-1</div>
  <button class="menu-btn" id="back-btn" onclick="showHub()">◀ ALL GAMES</button>
</header>

<div id="hub-view">
  <div class="hub-title">SELECT ANY BUILT-IN GAME (100% OFFLINE READY)</div>
  <div class="grid">
    <div class="card" onclick="startGame('FOOTBALL')">
      <div class="banner" style="background: linear-gradient(135deg, #1b4332, #2d6a4f);">🏈</div>
      <div class="card-info">
        <div><h3>Gridiron QB</h3><p>Snap, aim bullet passes, hand off to your RB, and score TDs.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('RUNNER')">
      <div class="banner" style="background: linear-gradient(135deg, #1d4ed8, #db2777);">🏃</div>
      <div class="card-info">
        <div><h3>Metro Dash</h3><p>3-lane subway runner! Dodge trains, jump barriers, grab coins.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('FLAPPY')">
      <div class="banner" style="background: linear-gradient(135deg, #0d9488, #22c55e);">🐦</div>
      <div class="card-info">
        <div><h3>Flappy Wing</h3><p>Tap or press Space to fly through endless green pipes.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('TETRIS')">
      <div class="banner" style="background: linear-gradient(135deg, #7c3aed, #ec4899);">🧱</div>
      <div class="card-info">
        <div><h3>Block Stacker</h3><p>Classic falling tetromino puzzle—rotate and clear lines.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('INVADERS')">
      <div class="banner" style="background: linear-gradient(135deg, #0f172a, #3b82f6);">👾</div>
      <div class="card-info">
        <div><h3>Space Defenders</h3><p>Blast descending alien waves and dodge plasma bolts.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('G2048')">
      <div class="banner" style="background: linear-gradient(135deg, #d97706, #fbbf24);">🔢</div>
      <div class="card-info">
        <div><h3>2048 Tiles</h3><p>Swipe or use Arrow keys to merge numbers up to 2048.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('DINO')">
      <div class="banner" style="background: linear-gradient(135deg, #334155, #64748b);">🦖</div>
      <div class="card-info">
        <div><h3>Desert Rex</h3><p>Sprint across the desert and leap over incoming cacti.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('SNAKE')">
      <div class="banner" style="background: linear-gradient(135deg, #15803d, #84cc16);">🐍</div>
      <div class="card-info">
        <div><h3>Neon Snake</h3><p>Eat glowing apples and grow without hitting the walls.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('BREAKOUT')">
      <div class="banner" style="background: linear-gradient(135deg, #b91c1c, #f59e0b);">🏓</div>
      <div class="card-info">
        <div><h3>Brick Breaker</h3><p>Bounce the energy ball to smash all neon brick rows.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>

    <div class="card" onclick="startGame('PONG')">
      <div class="banner" style="background: linear-gradient(135deg, #1e293b, #0ea5e9);">🎾</div>
      <div class="card-info">
        <div><h3>Cyber Pong</h3><p>First to 7 points wins in high-speed neon table tennis.</p></div>
        <div class="play-tag">▶ PLAY</div>
      </div>
    </div>
  </div>
</div>

<div id="game-view">
  <div id="canvas-container">
    <canvas id="canvas" width="960" height="540"></canvas>
  </div>
  <div id="controls-hint"></div>
</div>

<script>
const canvas = document.getElementById('canvas');
const ctx = canvas.getContext('2d');
const hubView = document.getElementById('hub-view');
const gameView = document.getElementById('game-view');
const backBtn = document.getElementById('back-btn');
const hintEl = document.getElementById('controls-hint');

let activeGame = null;
let animFrameId = null;

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function tone(freq, type = 'square', dur = 0.09, vol = 0.07, slide = null) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  const osc = audioCtx.createOscillator();
  const gain = audioCtx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
  if (slide) osc.frequency.exponentialRampToValueAtTime(slide, audioCtx.currentTime + dur);
  gain.gain.setValueAtTime(vol, audioCtx.currentTime);
  gain.gain.exponentialRampToValueAtTime(0.005, audioCtx.currentTime + dur);
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  osc.stop(audioCtx.currentTime + dur);
}

const ENGINES = {};

function showHub() {
  activeGame = null;
  if (animFrameId) cancelAnimationFrame(animFrameId);
  gameView.style.display = 'none';
  backBtn.style.display = 'none';
  hubView.style.display = 'block';
}

function startGame(type) {
  if (audioCtx.state === 'suspended') audioCtx.resume();
  hubView.style.display = 'none';
  gameView.style.display = 'flex';
  backBtn.style.display = 'block';
  activeGame = type;
  const g = ENGINES[type];
  hintEl.innerText = g.hint;
  g.init();

  let last = performance.now();
  function loop(now) {
    if (!activeGame) return;
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    g.loop(dt);
    animFrameId = requestAnimationFrame(loop);
  }
  animFrameId = requestAnimationFrame(loop);
}

function getPos(cx, cy) {
  const r = canvas.getBoundingClientRect();
  return { x: (cx - r.left) * (canvas.width / r.width), y: (cy - r.top) * (canvas.height / r.height) };
}

let tStart = null;
canvas.addEventListener('mousedown', e => {
  const p = getPos(e.clientX, e.clientY); tStart = p;
  ENGINES[activeGame]?.down?.(p);
});
window.addEventListener('mousemove', e => {
  const p = getPos(e.clientX, e.clientY);
  ENGINES[activeGame]?.move?.(p);
});
window.addEventListener('mouseup', e => {
  const p = getPos(e.clientX, e.clientY);
  ENGINES[activeGame]?.up?.(p);
  if (tStart) ENGINES[activeGame]?.swipe?.(tStart, p);
  tStart = null;
});
canvas.addEventListener('touchstart', e => {
  e.preventDefault();
  const p = getPos(e.touches[0].clientX, e.touches[0].clientY); tStart = p;
  ENGINES[activeGame]?.down?.(p);
}, { passive: false });
window.addEventListener('touchmove', e => {
  if (!e.touches.length) return;
  const p = getPos(e.touches[0].clientX, e.touches[0].clientY);
  ENGINES[activeGame]?.move?.(p);
}, { passive: false });
window.addEventListener('touchend', e => {
  if (!tStart) return;
  const p = e.changedTouches.length ? getPos(e.changedTouches[0].clientX, e.changedTouches[0].clientY) : tStart;
  ENGINES[activeGame]?.up?.(p);
  ENGINES[activeGame]?.swipe?.(tStart, p);
  tStart = null;
});
window.addEventListener('keydown', e => {
  if (['ArrowUp','ArrowDown','ArrowLeft','ArrowRight','Space'].includes(e.code) && activeGame) e.preventDefault();
  ENGINES[activeGame]?.key?.(e.code, true);
});
window.addEventListener('keyup', e => {
  ENGINES[activeGame]?.key?.(e.code, false);
});

// 1. GRIDIRON QB
ENGINES.FOOTBALL = (() => {
  const PPY = 17, FIELD_W = 120, FIELD_H = 53.3, TOP = 70;
  let st, qb, rb, recs, ol, defs, ball;
  function init() {
    st = { phase: 'PRE', title: 'TAP TO SNAP', sub: 'DRAG BACK TO THROW • TAP RB TO RUN', score: 0, opp: 0, down: 1, toGo: 10, los: 35, fd: 45, camX: 15, drag: false, dStart: {x:0,y:0}, dCurr: {x:0,y:0}, keys: {} };
    resetPlay();
  }
  function resetPlay() {
    st.phase = 'PRE'; st.title = ''; st.sub = ''; st.drag = false;
    const mid = FIELD_H / 2;
    qb = { x: st.los - 4, y: mid, spd: 12, scram: false };
    rb = { x: st.los - 5.5, y: mid + 4, spd: 13.8 };
    ol = [-3,-1.5,0,1.5,3].map(o => ({ x: st.los - 0.7, y: mid + o, spd: 7.5 }));
    const routes = ['STREAK','SLANT','POST','OUT'];
    recs = [-15,-7.5,7.5,15].map((o,i) => ({ x: st.los - 0.7, y: mid + o, sy: mid + o, route: routes[i], spd: 14.4 }));
    defs = [
      ...[-2.5,0,2.5].map(o => ({ x: st.los + 1, y: mid + o, role: 'RUSH', spd: 10.2, blk: 0, stun: 0 })),
      ...recs.map(r => ({ x: st.los + 5, y: r.y, role: 'COV', target: r, spd: 13.1, blk: 0, stun: 0 }))
    ];
    ball = { x: qb.x, y: qb.y, z: 1.5, vx: 0, vy: 0, vz: 0, carrier: qb, air: false, lx: 0, ly: 0 };
  }
  function endPlay(endX, msg, turnover = false) {
    if (st.phase === 'OVER') return;
    st.phase = 'OVER'; tone(2600, 'sine', 0.14);
    if (!turnover && endX >= 110) {
      tone(523, 'square', 0.25, 0.1, 1046); st.score += 7; st.title = 'TOUCHDOWN! +7'; st.sub = 'TAP FOR NEXT DRIVE';
      st.down = 1; st.toGo = 10; st.los = 35; st.fd = 45; return;
    }
    if (turnover) {
      st.opp += 3; st.title = msg; st.sub = 'OPP FG (+3) • TAP TO CONTINUE';
      st.down = 1; st.toGo = 10; st.los = 35; st.fd = 45; return;
    }
    endX = Math.max(11, Math.min(109, endX));
    const gain = Math.round(endX - st.los); st.los = Math.round(endX);
    if (st.los >= st.fd) {
      tone(660); st.down = 1; st.toGo = 10; st.fd = Math.min(110, st.los + 10); st.title = `1ST DOWN! (+${gain} YDS)`;
    } else {
      st.down++; st.toGo = st.fd - st.los;
      if (st.down > 4) { st.opp += 3; st.title = 'TURNOVER ON DOWNS'; st.down = 1; st.toGo = 10; st.los = 35; st.fd = 45; }
      else st.title = `${msg} (${gain >= 0 ? '+' : ''}${gain} YDS)`;
    }
    st.sub = 'TAP FIELD FOR NEXT PLAY';
  }
  function down(p) {
    if (st.phase === 'OVER') return resetPlay();
    if (st.phase === 'PRE') { st.phase = 'PASS'; tone(160); return; }
    if (st.phase === 'PASS' && ball.carrier === qb) {
      if (Math.hypot(p.x - (qb.x - st.camX)*PPY, p.y - (TOP + qb.y*PPY)) < 38) { qb.scram = true; st.phase = 'RUN'; return; }
      if (Math.hypot(p.x - (rb.x - st.camX)*PPY, p.y - (TOP + rb.y*PPY)) < 38) { ball.carrier = rb; st.phase = 'RUN'; tone(520); return; }
    }
    st.drag = true; st.dStart = p; st.dCurr = p;
  }
  function move(p) { if (st.drag) st.dCurr = p; }
  function up() {
    if (!st.drag) return; st.drag = false;
    if (st.phase === 'PASS' && !qb.scram && ball.carrier === qb) {
      const dx = st.dStart.x - st.dCurr.x, dy = st.dStart.y - st.dCurr.y, pull = Math.min(Math.hypot(dx, dy), 200);
      if (pull > 18) {
        const pow = pull / 200, spd = 21 + pow * 22, vz = 8.5, ang = Math.atan2(dy, dx), ft = (vz + Math.sqrt(vz*vz + 22)) / 22;
        ball.carrier = null; ball.air = true; ball.vx = Math.cos(ang)*spd; ball.vy = Math.sin(ang)*spd; ball.vz = vz;
        ball.lx = ball.x + ball.vx*ft; ball.ly = ball.y + ball.vy*ft; tone(300, 'triangle', 0.14, 0.1, 580);
      }
    }
  }
  function key(c, d) {
    st.keys[c] = d;
    if (d && c === 'Space') { if (st.phase === 'PRE') { st.phase = 'PASS'; tone(160); } else if (st.phase === 'OVER') resetPlay(); }
  }
  function loop(dt) {
    st.camX += (Math.max(0, Math.min(FIELD_W - canvas.width / PPY, ball.x - 20)) - st.camX) * 8 * dt;
    if (st.phase === 'PASS' || st.phase === 'RUN') {
      if (ball.carrier !== rb && rb.x < st.los + 3) { rb.x += 6 * dt; rb.y += 4 * dt; }
      recs.forEach(r => {
        if (ball.carrier === r) return;
        const d = r.x - st.los; let vx = r.spd, vy = 0;
        if (r.route === 'SLANT' && d > 4) { vx = r.spd * 0.8; vy = r.sy < FIELD_H/2 ? 9 : -9; }
        else if (r.route === 'POST' && d > 11) { vx = r.spd * 0.85; vy = r.sy < FIELD_H/2 ? 8 : -8; }
        else if (r.route === 'OUT' && d > 9) { vx = 2; vy = r.sy < FIELD_H/2 ? -12 : 12; }
        if (ball.air && Math.hypot(ball.lx - r.x, ball.ly - r.y) < 16) {
          const a = Math.atan2(ball.ly - r.y, ball.lx - r.x); vx = Math.cos(a)*r.spd*1.1; vy = Math.sin(a)*r.spd*1.1;
        }
        r.x = Math.min(116, r.x + vx*dt); r.y = Math.max(2, Math.min(FIELD_H - 2, r.y + vy*dt));
      });
      if (ball.carrier && (st.phase === 'RUN' || qb.scram)) {
        const c = ball.carrier; let my = 0;
        if (st.drag) { const dy = st.dCurr.y - st.dStart.y; if (Math.abs(dy) > 6) my = Math.sign(dy); }
        if (st.keys['ArrowUp'] || st.keys['KeyW']) my = -1;
        if (st.keys['ArrowDown'] || st.keys['KeyS']) my = 1;
        c.x += c.spd * dt; c.y += my * c.spd * 0.9 * dt; ball.x = c.x; ball.y = c.y;
        if (c.y <= 1.2 || c.y >= FIELD_H - 1.2) return endPlay(c.x, 'OUT OF BOUNDS');
        if (c.x >= 110) return endPlay(c.x, 'TOUCHDOWN!');
      }
      if (ball.air) {
        ball.x += ball.vx*dt; ball.y += ball.vy*dt; ball.z += ball.vz*dt; ball.vz -= 22*dt;
        if (ball.z <= 3 && ball.z >= 0) {
          for (let r of [...recs, rb]) if (Math.hypot(ball.x - r.x, ball.y - r.y) < 2.2) { ball.air = false; ball.carrier = r; ball.z = 1.5; st.phase = 'RUN'; tone(620); break; }
          if (ball.air) for (let d of defs) if (Math.hypot(ball.x - d.x, ball.y - d.y) < 1.2) { ball.air = false; return endPlay(ball.x, 'INTERCEPTED!', true); }
        }
        if (ball.z <= 0) { ball.air = false; return endPlay(st.los, 'INCOMPLETE'); }
      }
      ol.forEach(o => {
        let t = defs[0], best = 99; defs.forEach(d => { const dist = Math.hypot(d.x - o.x, d.y - o.y); if (dist < best) { best = dist; t = d; } });
        if (best < 6) { const a = Math.atan2(t.y - o.y, t.x - o.x); o.x += Math.cos(a)*o.spd*dt; o.y += Math.sin(a)*o.spd*dt; if (best < 1.3) t.blk = 0.3; }
      });
      for (let d of defs) {
        if (d.blk > 0) { d.blk -= dt; continue; }
        if (d.stun > 0) { d.stun -= dt; continue; }
        const tx = (st.phase === 'RUN' || ball.air || d.role === 'RUSH') ? ball.x : d.target.x + 1;
        const ty = (st.phase === 'RUN' || ball.air || d.role === 'RUSH') ? ball.y : d.target.y;
        const a = Math.atan2(ty - d.y, tx - d.x); d.x += Math.cos(a)*d.spd*dt; d.y += Math.sin(a)*d.spd*dt;
        if (ball.carrier && Math.hypot(d.x - ball.carrier.x, d.y - ball.carrier.y) < 1.25) {
          if (ball.carrier !== qb && Math.random() < 0.35) { d.stun = 1.3; tone(240); continue; }
          tone(100, 'sawtooth', 0.2); return endPlay(ball.carrier.x, ball.carrier === qb ? 'SACKED!' : 'TACKLED');
        }
      }
    }
    ctx.fillStyle = '#181c28'; ctx.fillRect(0, 0, canvas.width, TOP);
    ctx.save(); ctx.translate(-Math.round(st.camX * PPY), 0);
    for (let y = 0; y < FIELD_W; y += 5) { ctx.fillStyle = (y/5)%2===0 ? '#2b7a2b' : '#246b24'; ctx.fillRect(y*PPY, TOP, 5*PPY, canvas.height - TOP); }
    ctx.fillStyle = '#141414'; ctx.fillRect(0, TOP, 10*PPY, canvas.height - TOP);
    ctx.fillStyle = '#c60c30'; ctx.fillRect(110*PPY, TOP, 10*PPY, canvas.height - TOP);
    ctx.strokeStyle = 'rgba(255,255,255,0.75)'; ctx.lineWidth = 2;
    for (let y = 10; y <= 110; y += 5) { ctx.beginPath(); ctx.moveTo(y*PPY, TOP); ctx.lineTo(y*PPY, canvas.height); ctx.stroke(); }
    ctx.strokeStyle = '#3a86ff'; ctx.lineWidth = 4; ctx.beginPath(); ctx.moveTo(st.los*PPY, TOP); ctx.lineTo(st.los*PPY, canvas.height); ctx.stroke();
    ctx.strokeStyle = '#ffbe0b'; ctx.beginPath(); ctx.moveTo(st.fd*PPY, TOP); ctx.lineTo(st.fd*PPY, canvas.height); ctx.stroke();
    const drawP = (p, j, pt) => {
      const px = p.x*PPY, py = TOP + p.y*PPY;
      ctx.fillStyle = 'rgba(0,0,0,0.4)'; ctx.beginPath(); ctx.ellipse(px, py+12, 11, 4, 0, 0, Math.PI*2); ctx.fill();
      ctx.fillStyle = pt; ctx.fillRect(px-6, py+2, 12, 9); ctx.fillStyle = j; ctx.fillRect(px-8, py-9, 16, 12);
      ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(px, py-13, 6, 0, Math.PI*2); ctx.fill();
    };
    ol.forEach(p => drawP(p, '#141414', '#ffb612')); recs.forEach(p => drawP(p, '#141414', '#ffb612'));
    defs.forEach(p => drawP(p, '#c60c30', '#fff')); drawP(rb, '#141414', '#ffb612'); drawP(qb, '#141414', '#ffb612');
    ctx.fillStyle = '#8b4513'; ctx.beginPath(); ctx.ellipse(ball.x*PPY, TOP + ball.y*PPY - ball.z*6, 7, 4, 0, 0, Math.PI*2); ctx.fill();
